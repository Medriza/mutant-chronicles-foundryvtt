{{!-- ── Stats Tab ─────────────────────────────────────────────────── --}}
{{!-- Three-column layout: Attributes | Wounds | Status & Injuries    --}}
<div class="tab stats flexrow" data-group="primary" data-tab="stats">

  {{!-- Column 1: Attributes + Derived Stats ──────────────────────── --}}
  <div class="attributes-section flexcol">
    <h3 class="section-header">Attributes</h3>
    {{!-- {{#each obj as |value key|}} iterates the attributes object.
         'key' is the property name (agility, awareness, etc.),
         'attr' is the value object { value: 5 }.
         The name attribute uses dot notation so Foundry knows which
         field to update when the user changes a number. --}}
    <ol class="attributes-list">
      {{#each system.attributes as |attr key|}}
      <li class="attribute flexrow" data-attribute="{{key}}">
        <span class="attribute-label">{{key}}</span>
        <input class="attribute-value" type="number"
               name="system.attributes.{{key}}.value"
               value="{{attr.value}}" min="2" max="17" />
      </li>
      {{/each}}
    </ol>

    <h3 class="section-header">Derived Stats</h3>
    <div class="derived-stat flexrow">
      <label>Melee Bonus Dmg</label>
      <input type="number" name="system.derivedStats.meleeBonusDamage"
             value="{{system.derivedStats.meleeBonusDamage}}" />
    </div>
    <div class="derived-stat flexrow">
      <label>Ranged Bonus Dmg</label>
      <input type="number" name="system.derivedStats.rangedBonusDamage"
             value="{{system.derivedStats.rangedBonusDamage}}" />
    </div>
    <div class="derived-stat flexrow">
      <label>Influence</label>
      <input type="number" name="system.derivedStats.influence"
             value="{{system.derivedStats.influence}}" />
    </div>
  </div>

  {{!-- Column 2: Physical + Mental Wounds ────────────────────────── --}}
  <div class="wounds-section flexcol">
    <h3 class="section-header">Physical Wounds</h3>

    <h4>Light Wounds (by location)</h4>
    {{!-- lightWoundSlots is an array of location objects: { loc, path, soak, slots }.
         slot.state is 'filled' | 'active' | 'inactive' — drives the CSS class.
         data-wound-path tells the click handler which actor field to update.
         Soak is a temporary manual input until the armour system automates it. --}}
    {{#each lightWoundSlots as |locationData|}}
    <div class="wound-location flexrow" data-wound-path="{{locationData.path}}">
      <label class="wound-label">{{locationData.loc}}</label>
      <input class="soak-value" type="number"
             name="{{locationData.path}}.soak"
             value="{{locationData.soak}}" min="0" title="Soak" />
      <div class="wound-slots flexrow">
        {{#each locationData.slots as |slot|}}
        <div class="wound-slot {{slot.state}}"></div>
        {{/each}}
      </div>
    </div>
    {{/each}}

    <div class="serious-wounds flexrow" data-wound-path="{{seriousWoundSlots.path}}">
      <label class="wound-label">Serious</label>
      <div class="wound-slots flexrow">
        {{#each seriousWoundSlots.slots as |slot|}}
        <div class="wound-slot {{slot.state}}"></div>
        {{/each}}
      </div>
    </div>

    <div class="critical-wounds flexrow" data-wound-path="{{criticalWoundSlots.path}}">
      <label class="wound-label">Critical</label>
      <div class="wound-slots flexrow">
        {{#each criticalWoundSlots.slots as |slot|}}
        <div class="wound-slot {{slot.state}}"></div>
        {{/each}}
      </div>
    </div>

    <h3 class="section-header">Mental Wounds</h3>
    {{!-- mentalWoundSlots is always 20 entries (the physical sheet max).
         slot.state drives the CSS class: 'filled' | 'active' | 'inactive'.
         slot.tainted adds the 'tainted' class, which the CSS uses to draw
         the corruption pip via ::after. Click handlers in activateListeners()
         enforce left-to-right fill / right-to-left clear. --}}
    <div class="mental-wounds-slots flexrow">
      {{#each mentalWoundSlots as |slot|}}
      <div class="mental-slot {{slot.state}}{{#if slot.tainted}} tainted{{/if}}"
           data-slot="{{slot.key}}"></div>
      {{/each}}
    </div>
  </div>

  {{!-- Column 3: Status, Mysticism toggle, Critical Injuries ─────── --}}
  <div class="status-section flexcol">
    <h3 class="section-header">Status</h3>
    <input type="text" name="system.status" value="{{system.status}}"
           placeholder="Current conditions…" />

    <h3 class="section-header">Mysticism</h3>
    <div class="form-group flexrow">
      <label>Enable Spells Tab</label>
      <input type="checkbox" name="system.useMysticism"
             data-dtype="Boolean" {{#if system.useMysticism}}checked{{/if}} />
    </div>

    <h3 class="section-header">Critical Injuries</h3>
    <div class="critical-injuries-list">
      {{#each system.criticalInjuries}}
        <div class="critical-injury">{{this}}</div>
      {{else}}
        <p class="empty-label">No critical injuries.</p>
      {{/each}}
    </div>
  </div>

</div>
