{{!-- ── Talents Tab ──────────────────────────────────────────────── --}}
<div class="tab talents flexcol" data-group="primary" data-tab="talents">

  {{#if talents.length}}
  <div class="talent-list-header">
    <span class="th-name">Talent</span>
    <span class="th-attr">Attribute</span>
    <span class="th-desc">Description</span>
    <span class="th-ctrl"></span>
    <span class="th-rank">Rnk</span>
  </div>
  <ol class="talent-list">
    {{#each talents as |talent|}}
    <li class="talent-row flexrow" data-item-id="{{talent.id}}">
      <span class="talent-name">{{talent.name}}</span>
      <span class="talent-attr">{{talent.system.attribute}}</span>
      <span class="talent-desc">{{talent.system.shortDescription}}</span>
      <a class="item-edit" title="Edit Talent"><i class="fas fa-edit"></i></a>
      <a class="item-delete" title="Delete Talent"><i class="fas fa-trash"></i></a>
      <span class="talent-rank-display">{{#if talent.system.isRanked}}{{talent.system.rank}}{{/if}}</span>
    </li>
    {{/each}}
  </ol>
  {{else}}
    <p class="empty-label">No talents yet. Click + to add one.</p>
  {{/if}}

</div>
