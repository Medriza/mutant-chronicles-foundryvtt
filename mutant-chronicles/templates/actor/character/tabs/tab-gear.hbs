{{!-- ── Gear Tab ─────────────────────────────────────────────────── --}}
{{!-- Three sections: Weapons, Armour, Belongings (equipment items).
     Columns match the official MC3 character sheet layout.
     Some Belongings columns (load, reliability, etc.) are placeholders
     until item types are expanded in the post-Module-8 backlog. --}}
<div class="tab gear flexcol" data-group="primary" data-tab="gear">

  {{!-- Weapons ───────────────────────────────────────────────────── --}}
  <section class="gear-section">
    <header class="gear-section-header flexrow">
      <h3>Weapons</h3>
      <a class="item-create" data-item-type="weapon" title="Add Weapon">
        <i class="fas fa-plus"></i> Add
      </a>
    </header>
    {{#if weapons.length}}
    <table class="weapons-table">
      <thead>
        <tr>
          <th>Name</th>
          <th class="location-col">Range</th>
          <th class="location-col">Damage</th>
          <th class="location-col">Mode</th>
          <th class="location-col">Reliability</th>
          <th>Qualities</th>
          <th class="controls"></th>
        </tr>
      </thead>
      <tbody>
        {{#each weapons as |weapon|}}
        <tr class="weapon-row" data-item-id="{{weapon.id}}">
          <td><a class="weapon-attack">{{weapon.name}}</a></td>
          <td class="location-col">{{weapon.system.range}}</td>
          <td class="location-col">{{weapon.system.damageFlat}}+{{weapon.system.damageDice}}<i class="fas fa-eclipse dsd-icon"></i></td>
          <td class="location-col">{{weapon.system.mode}}</td>
          <td class="location-col">{{weapon.system.reliability}}</td>
          <td>{{weapon.system.qualities}}</td>
          <td class="controls flexrow">
            <a class="item-edit" title="Edit"><i class="fas fa-edit"></i></a>
            <a class="item-delete" title="Delete"><i class="fas fa-trash"></i></a>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{else}}
      <p class="empty-label">No weapons.</p>
    {{/if}}
  </section>

  {{!-- Armour ────────────────────────────────────────────────────── --}}
  <section class="gear-section">
    <header class="gear-section-header flexrow">
      <h3>Armour</h3>
      <a class="item-create" data-item-type="armour" title="Add Armour">
        <i class="fas fa-plus"></i> Add
      </a>
    </header>
    {{#if armours.length}}
    <table class="armour-table">
      <thead>
        <tr>
          <th>Name</th>
          <th class="location-col">Head</th>
          <th class="location-col">Torso</th>
          <th class="location-col">Left Arm</th>
          <th class="location-col">Right Arm</th>
          <th class="location-col">Left Leg</th>
          <th class="location-col">Right Leg</th>
          <th class="worn-col">Worn</th>
          <th class="location-col">Enc</th>
          <th class="location-col">Reliability</th>
          <th class="controls"></th>
        </tr>
      </thead>
      <tbody>
        {{#each armours as |armour|}}
        <tr class="armour-row" data-item-id="{{armour.id}}">
          <td>{{armour.name}}</td>
          <td class="location-col">{{armour.system.soak.head}}</td>
          <td class="location-col">{{armour.system.soak.torso}}</td>
          <td class="location-col">{{armour.system.soak.leftArm}}</td>
          <td class="location-col">{{armour.system.soak.rightArm}}</td>
          <td class="location-col">{{armour.system.soak.leftLeg}}</td>
          <td class="location-col">{{armour.system.soak.rightLeg}}</td>
          <td class="worn-col">
            <input class="armour-worn-toggle" type="checkbox"
                   {{#if armour.system.worn}}checked{{/if}} />
          </td>
          <td class="location-col">{{armour.system.enc}}</td>
          <td class="location-col">{{armour.system.reliability}}</td>
          <td class="controls flexrow">
            <a class="item-edit" title="Edit"><i class="fas fa-edit"></i></a>
            <a class="item-delete" title="Delete"><i class="fas fa-trash"></i></a>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{else}}
      <p class="empty-label">No armour.</p>
    {{/if}}
  </section>

  {{!-- Belongings ────────────────────────────────────────────────── --}}
  <section class="gear-section">
    <header class="gear-section-header flexrow">
      <h3>Belongings</h3>
      <a class="item-create" data-item-type="equipment" title="Add Equipment">
        <i class="fas fa-plus"></i> Add
      </a>
    </header>
    {{#if equipment.length}}
    <table class="equipment-table">
      <thead>
        <tr>
          <th>Name</th>
          <th class="location-col">Quantity</th>
          <th class="location-col">Encumbrance</th>
          <th class="location-col">Reliability</th>
          <th class="location-col">Maintenance</th>
          <th class="controls"></th>
        </tr>
      </thead>
      <tbody>
        {{#each equipment as |item|}}
        <tr class="equipment-row" data-item-id="{{item.id}}">
          <td>{{item.name}}</td>
          <td class="location-col">{{item.system.quantity}}</td>
          <td class="location-col">{{item.system.enc}}</td>
          <td class="location-col">{{item.system.reliability}}</td>
          <td class="location-col">{{item.system.maintenance}}</td>
          <td class="controls flexrow">
            <a class="item-edit" title="Edit"><i class="fas fa-edit"></i></a>
            <a class="item-delete" title="Delete"><i class="fas fa-trash"></i></a>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{else}}
      <p class="empty-label">No belongings.</p>
    {{/if}}
  </section>

</div>
