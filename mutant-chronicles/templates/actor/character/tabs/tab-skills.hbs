{{!-- ── Skills Tab ───────────────────────────────────────────────── --}}
{{!-- Skills are embedded Items on the actor. getData() groups them
     into context.skillsByAttribute — an object keyed by attribute name,
     each containing an array of skill items for that attribute.
     EXP = expertise (adds to attribute to form TN).
     FOC = focus (roll ≤ this for 2 successes instead of 1).
     ★   = Signature Skill flag (unlocks EXP/FOC range 0–5).
     Click the skill name to roll. Edit button opens the item sheet. --}}
<div class="tab skills flexcol" data-group="primary" data-tab="skills">

  {{#each skillsByAttribute as |skillGroup attrKey|}}
    {{#if skillGroup.length}}
    <div class="skill-group" data-attribute="{{attrKey}}">
      {{!-- Attribute value input sits on the header band so the value is
           visible alongside the skills it governs. Uses Handlebars lookup
           to dynamically access system.attributes[attrKey].value. --}}
      <div class="skill-group-header flexrow">
        <span class="skill-group-name">{{camelToTitle attrKey}}</span>
        <input class="skill-group-attr" type="number"
               name="system.attributes.{{attrKey}}.value"
               value="{{lookup (lookup ../system.attributes attrKey) 'value'}}"
               min="2" max="17" title="{{camelToTitle attrKey}} value" />
        <span class="skill-col-label" title="Expertise">EXP</span>
        <span class="skill-col-label" title="Focus">FOC</span>
        <span class="skill-col-label" title="Signature Skill">★</span>
        <span class="skill-controls-spacer"></span>
      </div>
      <ol class="skill-list">
        {{#each skillGroup as |skill|}}
        <li class="skill-row flexrow{{#if skill.system.isAdvanced}} advanced{{/if}}" data-item-id="{{skill.id}}">
          <a class="skill-name skill-roll" title="Roll {{skill.name}}">{{skill.name}}</a>
          <span class="skill-exp">{{skill.system.expertise}}</span>
          <span class="skill-foc">{{skill.system.focus}}</span>
          <span class="skill-sig">{{#if skill.system.isSignature}}★{{/if}}</span>
          <span class="skill-controls flexrow">
            <a class="item-edit" title="Edit Skill"><i class="fas fa-edit"></i></a>
            <a class="item-delete" title="Delete Skill"><i class="fas fa-trash"></i></a>
          </span>
        </li>
        {{/each}}
      </ol>
    </div>
    {{/if}}
  {{/each}}

  {{!-- Skills whose attribute field is blank or unrecognised land here --}}
  {{#if skillsByAttribute.unassigned.length}}
  <div class="skill-group unassigned">
    <h3 class="skill-group-header">⚠ Unassigned Attribute</h3>
    <ol class="skill-list">
      {{#each skillsByAttribute.unassigned as |skill|}}
      <li class="skill-row flexrow" data-item-id="{{skill.id}}">
        <a class="skill-name skill-roll" title="Roll {{skill.name}}">{{skill.name}}</a>
        <span class="skill-exp">{{skill.system.expertise}}</span>
        <span class="skill-foc">{{skill.system.focus}}</span>
        <span class="skill-sig">{{#if skill.system.isSignature}}★{{/if}}</span>
        <span class="skill-controls flexrow">
          <a class="item-edit" title="Edit Skill"><i class="fas fa-edit"></i></a>
          <a class="item-delete" title="Delete Skill"><i class="fas fa-trash"></i></a>
        </span>
      </li>
      {{/each}}
    </ol>
  </div>
  {{/if}}


</div>
