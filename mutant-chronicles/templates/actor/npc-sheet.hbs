{{!-- ──────────────────────────────────────────────────────────────────────
     MC3 NPC Sheet — single page, no tabs.
     Wound display is controlled by system.useLocationWounds:
       false → simplified (one pool + per-location soak)
       true  → per-location (Head / Torso / Arms / Legs / Serious / Critical)
     ────────────────────────────────────────────────────────────────────── --}}
<form class="{{cssClass}} flexcol" autocomplete="off">

  {{!-- ── Header ───────────────────────────────────────────────────────── --}}
  <header class="sheet-header flexrow">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
    <div class="header-fields flexcol">
      <h1 class="charname">
        <input name="name" type="text" value="{{actor.name}}" placeholder="NPC Name" />
      </h1>
      <div class="header-details flexrow">
        <div class="form-group">
          <label>Faction</label>
          <input type="text" name="system.details.faction"
                 value="{{system.details.faction}}" placeholder="—" />
        </div>
        <div class="form-group">
          <label>Role</label>
          <input type="text" name="system.details.role"
                 value="{{system.details.role}}" placeholder="—" />
        </div>
      </div>
    </div>
  </header>

  <div class="npc-body flexcol">

    {{!-- ── Attributes Grid ─────────────────────────────────────────────────── --}}
    {{!-- 4-column layout matching the official MC3 stat block.
         Group 1 (STR / PHY / AGI / AWA) and Group 2 (COO / INT / MEN / PER)
         each have a dark name row above a value row, with the same
         gap-as-border trick used in the weapon stats grid.                   --}}
    <div class="npc-attr-grid">
      <div class="nag-title">Attributes</div>

      {{!-- All 8 attribute names in a single row --}}
      <div class="nag-label">Strength</div>
      <div class="nag-label">Physique</div>
      <div class="nag-label">Agility</div>
      <div class="nag-label">Awareness</div>
      <div class="nag-label">Coordination</div>
      <div class="nag-label">Intelligence</div>
      <div class="nag-label">Mental Str.</div>
      <div class="nag-label">Personality</div>

      {{!-- All 8 attribute values in a single row --}}
      <div class="nag-cell">
        <input type="number" name="system.attributes.strength.value"
               value="{{system.attributes.strength.value}}" min="2" max="17" />
      </div>
      <div class="nag-cell">
        <input type="number" name="system.attributes.physique.value"
               value="{{system.attributes.physique.value}}" min="2" max="17" />
      </div>
      <div class="nag-cell">
        <input type="number" name="system.attributes.agility.value"
               value="{{system.attributes.agility.value}}" min="2" max="17" />
      </div>
      <div class="nag-cell">
        <input type="number" name="system.attributes.awareness.value"
               value="{{system.attributes.awareness.value}}" min="2" max="17" />
      </div>
      <div class="nag-cell">
        <input type="number" name="system.attributes.coordination.value"
               value="{{system.attributes.coordination.value}}" min="2" max="17" />
      </div>
      <div class="nag-cell">
        <input type="number" name="system.attributes.intelligence.value"
               value="{{system.attributes.intelligence.value}}" min="2" max="17" />
      </div>
      <div class="nag-cell">
        <input type="number" name="system.attributes.mentalStrength.value"
               value="{{system.attributes.mentalStrength.value}}" min="2" max="17" />
      </div>
      <div class="nag-cell">
        <input type="number" name="system.attributes.personality.value"
               value="{{system.attributes.personality.value}}" min="2" max="17" />
      </div>
    </div>{{!-- end .npc-attr-grid --}}

    {{!-- ── Fields of Expertise Grid ────────────────────────────────────────── --}}
    {{!-- 6-column layout, one column per field. Each column shows:
           field name (clickable for a roll) → EXP/FOC sub-labels → paired inputs --}}
    <div class="npc-exp-grid">
      <div class="neg-title">Fields of Expertise</div>

      {{!-- Field name row (each cell is a roll trigger) --}}
      <div class="neg-field"><a class="expertise-roll" data-field="movement"  title="Roll Movement">Movement</a></div>
      <div class="neg-field"><a class="expertise-roll" data-field="combat"    title="Roll Combat">Combat</a></div>
      <div class="neg-field"><a class="expertise-roll" data-field="fortitude" title="Roll Fortitude">Fortitude</a></div>
      <div class="neg-field"><a class="expertise-roll" data-field="technical" title="Roll Technical">Technical</a></div>
      <div class="neg-field"><a class="expertise-roll" data-field="social"    title="Roll Social">Social</a></div>
      <div class="neg-field"><a class="expertise-roll" data-field="senses"    title="Roll Senses">Senses</a></div>

      {{!-- EXP / FOC sub-label row --}}
      <div class="neg-sublabel"><span class="neg-sub">EXP</span><span class="neg-sub">FOC</span></div>
      <div class="neg-sublabel"><span class="neg-sub">EXP</span><span class="neg-sub">FOC</span></div>
      <div class="neg-sublabel"><span class="neg-sub">EXP</span><span class="neg-sub">FOC</span></div>
      <div class="neg-sublabel"><span class="neg-sub">EXP</span><span class="neg-sub">FOC</span></div>
      <div class="neg-sublabel"><span class="neg-sub">EXP</span><span class="neg-sub">FOC</span></div>
      <div class="neg-sublabel"><span class="neg-sub">EXP</span><span class="neg-sub">FOC</span></div>

      {{!-- Value row — each cell holds a paired EXP + FOC input --}}
      <div class="neg-value">
        <input type="number" name="system.expertise.movement.exp"  value="{{system.expertise.movement.exp}}"  min="0" />
        <input type="number" name="system.expertise.movement.foc"  value="{{system.expertise.movement.foc}}"  min="0" />
      </div>
      <div class="neg-value">
        <input type="number" name="system.expertise.combat.exp"    value="{{system.expertise.combat.exp}}"    min="0" />
        <input type="number" name="system.expertise.combat.foc"    value="{{system.expertise.combat.foc}}"    min="0" />
      </div>
      <div class="neg-value">
        <input type="number" name="system.expertise.fortitude.exp" value="{{system.expertise.fortitude.exp}}" min="0" />
        <input type="number" name="system.expertise.fortitude.foc" value="{{system.expertise.fortitude.foc}}" min="0" />
      </div>
      <div class="neg-value">
        <input type="number" name="system.expertise.technical.exp" value="{{system.expertise.technical.exp}}" min="0" />
        <input type="number" name="system.expertise.technical.foc" value="{{system.expertise.technical.foc}}" min="0" />
      </div>
      <div class="neg-value">
        <input type="number" name="system.expertise.social.exp"    value="{{system.expertise.social.exp}}"    min="0" />
        <input type="number" name="system.expertise.social.foc"    value="{{system.expertise.social.foc}}"    min="0" />
      </div>
      <div class="neg-value">
        <input type="number" name="system.expertise.senses.exp"    value="{{system.expertise.senses.exp}}"    min="0" />
        <input type="number" name="system.expertise.senses.foc"    value="{{system.expertise.senses.foc}}"    min="0" />
      </div>
    </div>{{!-- end .npc-exp-grid --}}

    {{!-- ── Wounds ──────────────────────────────────────────────────────── --}}
    <section class="npc-wounds npc-section">
      <div class="section-header flexrow">
        <h3 class="section-label">Wounds</h3>
        <label class="wound-mode-toggle">
          Use Location Wounds
          <input type="checkbox" name="system.useLocationWounds"
                 {{#if system.useLocationWounds}}checked{{/if}} />
        </label>
      </div>

      {{#if system.useLocationWounds}}
      {{!-- Location wounds mode — compact two-column layout.                 --}}
      {{!-- Left group: Head / Torso. Right group: Arms / Legs.               --}}
      {{!-- Column order per group: Name | Soak | Current | Max.             --}}
      {{!-- Serious + Critical share one row. Mental spans the left half.    --}}
      <table class="wound-table">
        <thead>
          <tr>
            <th class="wound-name-col"></th>
            <th>Soak</th>
            <th>Current</th>
            <th>Max</th>
            <th class="wound-name-col wound-group-divider"></th>
            <th>Soak</th>
            <th>Current</th>
            <th>Max</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="wound-location-name">Head</td>
            <td><input type="number" name="system.wounds.light.head.soak"
                       value="{{system.wounds.light.head.soak}}" min="0" /></td>
            <td><input type="number" name="system.wounds.light.head.value"
                       value="{{system.wounds.light.head.value}}" min="0" /></td>
            <td><input type="number" name="system.wounds.light.head.max"
                       value="{{system.wounds.light.head.max}}" min="0" /></td>
            {{!-- Arms maps to leftArm — NPCs don't track left/right separately --}}
            <td class="wound-location-name wound-group-divider">Arms</td>
            <td><input type="number" name="system.wounds.light.leftArm.soak"
                       value="{{system.wounds.light.leftArm.soak}}" min="0" /></td>
            <td><input type="number" name="system.wounds.light.leftArm.value"
                       value="{{system.wounds.light.leftArm.value}}" min="0" /></td>
            <td><input type="number" name="system.wounds.light.leftArm.max"
                       value="{{system.wounds.light.leftArm.max}}" min="0" /></td>
          </tr>
          <tr>
            <td class="wound-location-name">Torso</td>
            <td><input type="number" name="system.wounds.light.torso.soak"
                       value="{{system.wounds.light.torso.soak}}" min="0" /></td>
            <td><input type="number" name="system.wounds.light.torso.value"
                       value="{{system.wounds.light.torso.value}}" min="0" /></td>
            <td><input type="number" name="system.wounds.light.torso.max"
                       value="{{system.wounds.light.torso.max}}" min="0" /></td>
            {{!-- Legs maps to leftLeg — same reason as above --}}
            <td class="wound-location-name wound-group-divider">Legs</td>
            <td><input type="number" name="system.wounds.light.leftLeg.soak"
                       value="{{system.wounds.light.leftLeg.soak}}" min="0" /></td>
            <td><input type="number" name="system.wounds.light.leftLeg.value"
                       value="{{system.wounds.light.leftLeg.value}}" min="0" /></td>
            <td><input type="number" name="system.wounds.light.leftLeg.max"
                       value="{{system.wounds.light.leftLeg.max}}" min="0" /></td>
          </tr>
        </tbody>
      </table>

      {{else}}
      {{!-- Simplified wounds mode ──────────────────────────────────────── --}}
      {{!-- One shared wound pool + per-location soak values.               --}}
      {{!-- The GM sets both value and max from the NPC's stat block.        --}}
      <div class="simplified-wounds flexrow">
        <div class="simple-wound-pool">
          <div class="wound-value-pair">
            <div class="wound-col">
              <div class="wound-col-label">Current Wounds</div>
              <input type="number" name="system.simpleWounds.value"
                     value="{{system.simpleWounds.value}}" min="0" />
            </div>
            <div class="wound-col">
              <div class="wound-col-label">Max Wounds</div>
              <input type="number" name="system.simpleWounds.max"
                     value="{{system.simpleWounds.max}}" min="0" />
            </div>
          </div>
        </div>
        <div class="simple-soak-block">
          <table class="soak-table">
            <thead>
              <tr class="soak-title-row">
                <th colspan="4">Soak by Location</th>
              </tr>
              <tr>
                <th>Head</th>
                <th>Torso</th>
                <th>Arms</th>
                <th>Legs</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><input type="number" name="system.wounds.light.head.soak"
                           value="{{system.wounds.light.head.soak}}" min="0" /></td>
                <td><input type="number" name="system.wounds.light.torso.soak"
                           value="{{system.wounds.light.torso.soak}}" min="0" /></td>
                <td><input type="number" name="system.wounds.light.leftArm.soak"
                           value="{{system.wounds.light.leftArm.soak}}" min="0" /></td>
                <td><input type="number" name="system.wounds.light.leftLeg.soak"
                           value="{{system.wounds.light.leftLeg.soak}}" min="0" /></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
      {{/if}}

    </section>

    {{!-- ── Attacks ──────────────────────────────────────────────────────── --}}
    {{!-- Uses the 'weapon' item type; just labelled 'Attacks' on NPC sheets. --}}
    <section class="npc-attacks npc-section">
      <div class="section-header flexrow">
        <h3 class="section-label">Attacks</h3>
        <a class="item-create" data-item-type="weapon" title="Add Attack">
          <i class="fas fa-plus"></i> Add
        </a>
      </div>
      {{#if attacks.length}}
      <table class="attacks-table items-list">
        <thead>
          <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Range</th>
            <th>Damage</th>
            <th>Mode</th>
            <th>Rel.</th>
            <th class="col-qualities">Qualities</th>
            <th class="controls"></th>
          </tr>
        </thead>
        <tbody>
          {{#each attacks as |attack|}}
          <tr class="item" data-item-id="{{attack.id}}">
            <td><a class="weapon-attack">{{attack.name}}</a></td>
            <td>{{attack.system.weaponType}}</td>
            <td>{{attack.system.range}}</td>
            <td>{{attack.system.damageFlat}}+{{attack.system.damageDice}}CD</td>
            <td>{{attack.system.mode}}</td>
            <td>{{attack.system.reliability}}</td>
            <td>{{attack.system.qualities}}</td>
            <td class="item-controls flexrow">
              <a class="item-edit" title="Edit"><i class="fas fa-edit"></i></a>
              <a class="item-delete" title="Delete"><i class="fas fa-trash"></i></a>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      {{else}}
      <p class="empty-label">No attacks.</p>
      {{/if}}
    </section>

    {{!-- ── Special Abilities ────────────────────────────────────────────── --}}
    {{!-- Uses the 'specialability' item type. Covers all NPC abilities       --}}
    {{!-- (regular and Dark Symmetry). Ranked abilities show rank next to name.--}}
    <section class="npc-abilities npc-section">
      <div class="section-header flexrow">
        <h3 class="section-label">Special Abilities</h3>
        <a class="item-create" data-item-type="specialability" title="Add Special Ability">
          <i class="fas fa-plus"></i> Add
        </a>
      </div>
      {{#if specialAbilities.length}}
      <table class="items-list">
        <tbody>
          {{#each specialAbilities as |ability|}}
          <tr class="item" data-item-id="{{ability.id}}">
            <td class="ability-name">
              {{ability.name}}{{#if ability.system.isRanked}} ({{ability.system.rank}})</span>{{/if}}
            </td>
            <td class="ability-desc">{{ability.system.description}}</td>
            <td class="item-controls flexrow">
              <a class="item-edit" title="Edit"><i class="fas fa-edit"></i></a>
              <a class="item-delete" title="Delete"><i class="fas fa-trash"></i></a>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      {{else}}
      <p class="empty-label">No special abilities.</p>
      {{/if}}
    </section>

    {{!-- ── Notes ────────────────────────────────────────────────────────── --}}
    <section class="npc-notes npc-section">
      <h3 class="section-label">Notes</h3>
      <textarea name="system.details.notes" rows="5"
                placeholder="GM notes, tactics, description...">{{system.details.notes}}</textarea>
    </section>

  </div>{{!-- end .npc-body --}}

</form>
