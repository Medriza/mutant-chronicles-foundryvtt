{{!-- ── MC3 Roll Dialog ──────────────────────────────────────────────────── --}}
{{!-- Rendered inside a Foundry DialogV2 popup before any dice are thrown.
     The 'mode' helper variable determines which block renders:
       isSkill      → PC skill roll  (TN pre-calculated; Buy Dice adds to DS pool)
       isExpertise  → NPC expertise roll (attribute chosen here)

     Field names read by the dialog callbacks in roll-dialog.js:
       isSkill:     buyDice, extraDice, difficulty
       isExpertise: attribute, extraDice, difficulty

     NOTE: Foundry's HTML sanitizer strips inline event handlers (oninput,
     onkeydown, onclick). All event wiring is in roll-dialog.js via Hooks.once.

     Counter stepper structure for Buy/Extra Dice:
       .counter-stepper  → flex row with − | value | + buttons
       hidden input       → stores the actual value for the JS callback
     Click handlers update the display span and the hidden input, then call
     syncTotal() to keep Bonus Dice in sync.                                  --}}

<div class="mc3-roll-dialog">

  {{!-- ── PC Skill Roll ─────────────────────────────────────────────────── --}}
  {{#if isSkill}}

  {{!-- Bar 1: Main formula — darkest band, brightest font --}}
  <div class="roll-formula-bar">
    <strong>{{skillName}}</strong>
    &nbsp;·&nbsp;
    {{attributeLabel}} {{attributeValue}}
    &nbsp;+&nbsp; EXP {{expertiseValue}}
    &nbsp;=&nbsp;
    <span class="roll-tn-value">TN {{tn}}</span>
  </div>

  {{!-- Bar 2: Focus line — slightly lighter band --}}
  <div class="roll-focus-bar">
    Focus ≤ {{focusValue}} → 2 successes
  </div>

  {{!-- Dice counters — side by side --}}
  <div class="dice-inputs-row">

    <div class="dice-counter">
      <div class="counter-label">Buy Dice</div>
      <div class="counter-hint">+1 DS per die · max 3</div>
      <div class="counter-stepper">
        <button type="button" class="stepper-btn stepper-down" data-name="buyDice">−</button>
        <span class="stepper-val">0</span>
        <button type="button" class="stepper-btn stepper-up"   data-name="buyDice">+</button>
      </div>
      <input type="hidden" name="buyDice" value="0" data-min="0" data-max="3" />
    </div>

    <div class="dice-counter">
      <div class="counter-label">Extra Dice</div>
      <div class="counter-hint">Free bonus d20s</div>
      <div class="counter-stepper">
        <button type="button" class="stepper-btn stepper-down" data-name="extraDice">−</button>
        <span class="stepper-val">0</span>
        <button type="button" class="stepper-btn stepper-up"   data-name="extraDice">+</button>
      </div>
      <input type="hidden" name="extraDice" value="0" data-min="0" data-max="99" />
    </div>

  </div>

  {{!-- Difficulty --}}
  <div class="form-group">
    <label for="difficulty">Difficulty</label>
    <select id="difficulty" name="difficulty">
      <option value="0">D0 — Routine</option>
      <option value="1" selected>D1 — Average</option>
      <option value="2">D2 — Challenging</option>
      <option value="3">D3 — Daunting</option>
      <option value="4">D4 — Dire</option>
      <option value="5">D5 — Epic</option>
    </select>
  </div>

  {{!-- Total bonus dice — display box, same visual as Buy/Extra counters --}}
  <div class="dice-bonus-row">
    <div class="dice-counter dice-bonus-box">
      <div class="counter-label">Bonus Dice</div>
      <div class="counter-hint">Total extra d20s</div>
      <div class="bonus-total-value">0</div>
    </div>
  </div>

  {{/if}}


  {{!-- ── NPC Expertise Roll ──────────────────────────────────────────────── --}}
  {{#if isExpertise}}

  {{!-- Bar 1: Field summary --}}
  <div class="roll-formula-bar">
    <strong>{{fieldLabel}}</strong>
    &nbsp;·&nbsp; EXP {{expertiseValue}}
    &nbsp;|&nbsp; FOC {{focusValue}}
  </div>

  {{!-- Bar 2: TN preview note --}}
  <div class="roll-focus-bar">
    TN = selected attribute + EXP ({{expertiseValue}})
  </div>

  {{!-- Attribute select --}}
  <div class="form-group">
    <label for="attr-select">Attribute</label>
    <select id="attr-select" name="attribute">
      {{#each attributes as |attr|}}
      <option value="{{attr.key}}">{{attr.label}} ({{attr.value}})</option>
      {{/each}}
    </select>
  </div>

  {{!-- Extra dice stepper --}}
  <div class="form-group">
    <label>Extra Dice</label>
    <div class="counter-stepper npc-stepper">
      <button type="button" class="stepper-btn stepper-down" data-name="extraDice">−</button>
      <span class="stepper-val">0</span>
      <button type="button" class="stepper-btn stepper-up"   data-name="extraDice">+</button>
    </div>
    <input type="hidden" name="extraDice" value="0" data-min="0" data-max="99" />
    <span class="counter-hint">Free bonus d20s</span>
  </div>

  {{!-- Difficulty --}}
  <div class="form-group">
    <label for="difficulty">Difficulty</label>
    <select id="difficulty" name="difficulty">
      <option value="0">D0 — Routine</option>
      <option value="1" selected>D1 — Average</option>
      <option value="2">D2 — Challenging</option>
      <option value="3">D3 — Daunting</option>
      <option value="4">D4 — Dire</option>
      <option value="5">D5 — Epic</option>
    </select>
  </div>

  {{/if}}

</div>
