{{!-- ── MC3 Roll Chat Card ───────────────────────────────────────────── --}}
{{!-- Rendered into the chat log after every MC3 skill/expertise roll.
     Context keys (all set by rollMC3() in mc3-roll.js):
       rollLabel         — skill or field name + attribute summary
       tn                — Target Number
       focus             — Focus threshold
       difficulty        — D0–D5
       dice              — array of { result, successes, isComplication, cssClass }
       totalSuccesses    — sum of all die successes
       totalComplications
       momentum          — totalSuccesses - difficulty (can be negative)
       isSuccess         — boolean                                               --}}

<div class="mc3-roll-card">

  {{!-- Header: roll name + key numbers --}}
  <div class="roll-card-header">
    {{#if weaponName}}
      <h3 class="roll-card-weapon-name">{{weaponName}}</h3>
      <div class="roll-card-skill">{{rollLabel}}{{#if rollFormula}} <span class="roll-card-formula">{{rollFormula}}</span>{{/if}}</div>
    {{else}}
      <h3 class="roll-card-title">{{rollLabel}}{{#if rollFormula}} <span class="roll-card-formula">{{rollFormula}}</span>{{/if}}</h3>
    {{/if}}
    <div class="roll-card-meta">
      <span title="Target Number">TN {{tn}}</span>
      <span class="meta-sep">·</span>
      <span title="Focus threshold">FOC {{focus}}</span>
      <span class="meta-sep">·</span>
      <span title="Difficulty">D{{difficulty}}</span>
    </div>
  </div>

  {{!-- Per-die results --}}
  <div class="roll-card-dice">
    {{#each dice as |die|}}
    <div class="die-result {{die.cssClass}}" title="{{die.result}} → {{die.successes}} success(es)">
      <span class="die-value">{{die.result}}</span>
      <span class="die-successes">
        {{#if die.isComplication}}
          ⚠
        {{else}}
          {{die.successes}}✓
        {{/if}}
      </span>
    </div>
    {{/each}}
  </div>

  {{!-- Totals row --}}
  <div class="roll-card-totals">
    <span class="total-successes">
      {{totalSuccesses}} success{{#if (ne totalSuccesses 1)}}es{{/if}}
    </span>
    {{#if totalComplications}}
    <span class="total-complications">
      · {{totalComplications}} complication{{#if (ne totalComplications 1)}}s{{/if}}
    </span>
    {{/if}}
  </div>

  {{!-- Verdict --}}
  <div class="roll-card-verdict {{#if isSuccess}}success{{else}}failure{{/if}}">
    {{#if isSuccess}}
      <strong>SUCCESS</strong>
      {{#if momentum}}
        <span class="momentum">+{{momentum}} Momentum</span>
      {{/if}}
    {{else}}
      <strong>FAILURE</strong>
      <span class="shortfall">{{momentum}} short</span>
    {{/if}}
  </div>

  {{!-- Damage controls — only on successful weapon attack rolls.
       State (remaining momentum, bonus dice) is managed via ChatMessage flags
       and kept current by the renderChatMessage hook in mutant-chronicles.js. --}}
  {{#if isSuccess}}
  {{#if weaponId}}
  <div class="roll-card-damage-controls">
    <span class="damage-momentum-remaining">+{{momentum}} <i class="fas fa-bolt"></i></span>
    <button class="add-damage-die-btn" type="button" title="Spend 1 Momentum for +1 Dark Symmetry Die">
      +1 <i class="fas fa-eclipse"></i>
    </button>
    <span class="damage-bonus-dsd" style="display:none">+0 <i class="fas fa-eclipse"></i></span>
    <button class="roll-damage-btn" type="button">Roll Damage</button>
  </div>
  {{/if}}
  {{/if}}

</div>
