{{!-- Equipment Item Sheet --}}
<form class="sheet equipment-sheet" autocomplete="off">

  {{!-- Header: icon + item name --}}
  <header class="item-sheet-header">
    <img class="item-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
    <div class="item-header-fields">
      <input class="item-title-input" name="name" type="text" value="{{item.name}}" placeholder="Equipment Name" />
      <div class="item-type-badge">Equipment</div>
    </div>
  </header>

  {{!-- Body --}}
  <section class="item-sheet-body">

    {{!-- Stats row 1: Quantity / Load / Restriction / Cost --}}
    <div class="equip-grid-4">
      <div class="esg-header">Quantity</div>
      <div class="esg-header">Load</div>
      <div class="esg-header">Restriction</div>
      <div class="esg-header">Cost</div>

      <div class="esg-cell">
        <input type="number" name="system.quantity" value="{{system.quantity}}" min="0" />
      </div>
      <div class="esg-cell">
        <input type="number" name="system.load" value="{{system.load}}" min="0" />
      </div>
      <div class="esg-cell">
        <input type="number" name="system.restriction" value="{{system.restriction}}" min="0" />
      </div>
      <div class="esg-cell">
        <input type="number" name="system.cost" value="{{system.cost}}" min="0" />
      </div>
    </div>{{!-- end .equip-grid-4 --}}

    {{!-- Stats row 2: Encumbrance / Reliability / Maintenance --}}
    <div class="equip-grid-3">
      <div class="esg-header">Encumbrance</div>
      <div class="esg-header">Reliability</div>
      <div class="esg-header">Maintenance</div>

      <div class="esg-cell">
        <input type="number" name="system.enc" value="{{system.enc}}" min="0" />
      </div>
      <div class="esg-cell">
        <select name="system.reliability">
          <option value="—" {{#if (eq system.reliability "—")}}selected{{/if}}>—</option>
          <option value="0" {{#if (eq system.reliability "0")}}selected{{/if}}>0</option>
          <option value="1" {{#if (eq system.reliability "1")}}selected{{/if}}>1</option>
          <option value="2" {{#if (eq system.reliability "2")}}selected{{/if}}>2</option>
          <option value="3" {{#if (eq system.reliability "3")}}selected{{/if}}>3</option>
          <option value="4" {{#if (eq system.reliability "4")}}selected{{/if}}>4</option>
          <option value="5" {{#if (eq system.reliability "5")}}selected{{/if}}>5</option>
          <option value="C" {{#if (eq system.reliability "C")}}selected{{/if}}>C</option>
        </select>
      </div>
      <div class="esg-cell">
        <input type="number" name="system.maintenance" value="{{system.maintenance}}" min="0" />
      </div>
    </div>{{!-- end .equip-grid-3 --}}

    {{!-- Description --}}
    <div class="item-form-group item-form-group--grow">
      <label>Description</label>
      <textarea name="system.description" placeholder="What is this item, what does it do?">{{system.description}}</textarea>
    </div>

  </section>
</form>
