{{!-- Armour Item Sheet --}}
<form class="sheet armour-sheet" autocomplete="off">

  {{!-- Header: icon + item name --}}
  <header class="item-sheet-header">
    <img class="item-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
    <div class="item-header-fields">
      <input class="item-title-input" name="name" type="text" value="{{item.name}}" placeholder="Armour Name" />
      <div class="item-type-badge">Armour</div>
    </div>
  </header>

  {{!-- Body --}}
  <section class="item-sheet-body">

    {{!-- Soak by location --}}
    <div class="item-section-label">Soak by Location</div>
    <div class="armour-soak-grid">

      <div class="armour-soak-row">
        <span class="soak-location-name">Head</span>
        <input type="number" name="system.soak.head" value="{{system.soak.head}}" min="0" />
      </div>
      <div class="armour-soak-row">
        <span class="soak-location-name">Torso</span>
        <input type="number" name="system.soak.torso" value="{{system.soak.torso}}" min="0" />
      </div>
      <div class="armour-soak-row">
        <span class="soak-location-name">Left Arm</span>
        <input type="number" name="system.soak.leftArm" value="{{system.soak.leftArm}}" min="0" />
      </div>
      <div class="armour-soak-row">
        <span class="soak-location-name">Right Arm</span>
        <input type="number" name="system.soak.rightArm" value="{{system.soak.rightArm}}" min="0" />
      </div>
      <div class="armour-soak-row">
        <span class="soak-location-name">Left Leg</span>
        <input type="number" name="system.soak.leftLeg" value="{{system.soak.leftLeg}}" min="0" />
      </div>
      <div class="armour-soak-row">
        <span class="soak-location-name">Right Leg</span>
        <input type="number" name="system.soak.rightLeg" value="{{system.soak.rightLeg}}" min="0" />
      </div>

    </div>{{!-- end .armour-soak-grid --}}

    {{!-- Faction --}}
    <div class="item-form-group">
      <label>Faction</label>
      <input type="text" name="system.faction" value="{{system.faction}}"
             placeholder="e.g. Bauhaus, Brotherhood" />
    </div>

    {{!-- Stats: Enc / Reliability / Restriction / Cost --}}
    <div class="armour-stats-grid">
      <div class="asg-header">Encumbrance</div>
      <div class="asg-header">Reliability</div>
      <div class="asg-header">Restriction</div>
      <div class="asg-header">Cost</div>

      <div class="asg-cell">
        <input type="number" name="system.enc" value="{{system.enc}}" min="0" />
      </div>
      <div class="asg-cell">
        <select name="system.reliability">
          <option value="—" {{#if (eq system.reliability "—")}}selected{{/if}}>—</option>
          <option value="0" {{#if (eq system.reliability "0")}}selected{{/if}}>0</option>
          <option value="1" {{#if (eq system.reliability "1")}}selected{{/if}}>1</option>
          <option value="2" {{#if (eq system.reliability "2")}}selected{{/if}}>2</option>
          <option value="3" {{#if (eq system.reliability "3")}}selected{{/if}}>3</option>
          <option value="4" {{#if (eq system.reliability "4")}}selected{{/if}}>4</option>
          <option value="5" {{#if (eq system.reliability "5")}}selected{{/if}}>5</option>
          <option value="C" {{#if (eq system.reliability "C")}}selected{{/if}}>C</option>
        </select>
      </div>
      <div class="asg-cell">
        <input type="number" name="system.restriction" value="{{system.restriction}}" min="0" />
      </div>
      <div class="asg-cell">
        <input type="number" name="system.cost" value="{{system.cost}}" min="0" />
      </div>
    </div>{{!-- end .armour-stats-grid --}}

    {{!-- Description --}}
    <div class="item-form-group item-form-group--grow">
      <label>Description</label>
      <textarea name="system.description" placeholder="Armour description, special rules...">{{system.description}}</textarea>
    </div>

  </section>
</form>
