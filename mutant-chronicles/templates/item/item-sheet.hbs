{{!-- Generic Item Sheet — fallback for any item type not yet assigned a dedicated template. --}}
<form class="sheet item-sheet" autocomplete="off">

  {{!-- Header: icon + item name --}}
  <header class="item-sheet-header">
    <img class="item-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
    <div class="item-header-fields">
      <input class="item-title-input" name="name" type="text" value="{{item.name}}" placeholder="Item Name" />
      <div class="item-type-badge">{{item.type}}</div>
    </div>
  </header>

  {{!-- Body: name + description (generic fallback) --}}
  <section class="item-sheet-body">
    <div class="item-form-group item-form-group--grow">
      <label>Description</label>
      <textarea name="system.description">{{system.description}}</textarea>
    </div>
  </section>

</form>
